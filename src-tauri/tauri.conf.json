{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Interleaf",
  "version": "0.1.1",
  "identifier": "com.paperjournal.desktop",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:1436",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "纸间 · Interleaf", "width": 1440, "height": 920, "minWidth": 1000, "minHeight": 650, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico"], "windows": { "nsis": { "languages": ["SimpChinese"], "displayLanguageSelector": false } } }
}
